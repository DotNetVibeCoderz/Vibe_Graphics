<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A build-time tool, never packed. -->
    <IsPackable>false</IsPackable>
    <AssemblyName>ThreeNet.PackageIcon</AssemblyName>
    <RootNamespace>ThreeNet.PackageIcon</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A build time tool, so this dependency never reaches a package. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

</Project>
