<Project Sdk="Microsoft.NET.Sdk">

  <!-- Example Three.Net plugin: drop the built DLL into an application's plugins folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ThreePlugin.Sample</AssemblyName>
    <RootNamespace>ThreePlugin.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides ThreeNet at runtime, so the plugin does not ship its own copy. -->
    <ProjectReference Include="..\..\src\ThreeNet\ThreeNet.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
