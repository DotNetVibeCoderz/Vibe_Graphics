<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tn="clr-namespace:ThreeNet.Avalonia;assembly=ThreeNet.Avalonia"
        x:Class="MotoCross.Views.MainWindow"
        Title="Three.Net Motocross"
        Width="1280" Height="760"
        MinWidth="900" MinHeight="560"
        Background="#07090D"
        RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.hud">
      <Setter Property="Foreground" Value="#F2F5F8" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#9BA7B4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#B0101418" />
      <Setter Property="BorderBrush" Value="#2A323C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BoxShadow" Value="0 8 26 0 #60000000" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#18202A" />
      <Setter Property="Foreground" Value="#D6DEE7" />
      <Setter Property="BorderBrush" Value="#2C3742" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26313D" />
    </Style>
  </Window.Styles>

  <Grid>
    <tn:ThreeNetView x:Name="Viewport" Focusable="True" />

    <!-- Speed and gear -->
    <Border Classes="panel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22">
      <StackPanel Width="210">
        <TextBlock Classes="label" Text="SPEED" />
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="SpeedText" Classes="hud" Text="0" FontSize="46" FontWeight="Bold" />
          <TextBlock Classes="hud" Text="km/h" FontSize="14" Margin="8,0,0,10" VerticalAlignment="Bottom" Foreground="#93A0AD" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
          <TextBlock Classes="label" Text="GEAR" VerticalAlignment="Center" />
          <TextBlock x:Name="GearText" Grid.Column="1" Classes="hud" Text="1" FontSize="20"
                     HorizontalAlignment="Right" FontWeight="Bold" />
        </Grid>
        <ProgressBar x:Name="RevBar" Minimum="0" Maximum="1" Height="8" Margin="0,8,0,0"
                     Foreground="#FF7A18" Background="#1C242E" CornerRadius="4" />
      </StackPanel>
    </Border>

    <!-- Lap and timing -->
    <Border Classes="panel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22">
      <StackPanel Width="230">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="label" Text="LAP" VerticalAlignment="Center" />
          <TextBlock x:Name="LapText" Grid.Column="1" Classes="hud" Text="1 / 3" FontSize="18"
                     HorizontalAlignment="Right" FontWeight="Bold" />
        </Grid>
        <ProgressBar x:Name="LapBar" Minimum="0" Maximum="1" Height="6" Margin="0,6,0,10"
                     Foreground="#4FD1E5" Background="#1C242E" CornerRadius="3" />
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
          <TextBlock Classes="label" Text="CURRENT" VerticalAlignment="Center" />
          <TextBlock x:Name="LapTimeText" Grid.Column="1" Classes="hud" Text="00:00.000" HorizontalAlignment="Right" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
          <TextBlock Classes="label" Text="BEST" VerticalAlignment="Center" />
          <TextBlock x:Name="BestLapText" Grid.Column="1" Classes="hud" Text="--:--.---" HorizontalAlignment="Right"
                     Foreground="#8FE3A2" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
          <TextBlock Classes="label" Text="AIR" VerticalAlignment="Center" />
          <TextBlock x:Name="AirText" Grid.Column="1" Classes="hud" Text="0.00 s" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Mini map -->
    <Border Classes="panel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="22" Padding="10">
      <Canvas x:Name="MiniMap" Width="180" Height="180" Background="#7A0B0E13" />
    </Border>

    <!-- Toolbar -->
    <Border Classes="panel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="🏍" FontSize="18" VerticalAlignment="Center" Margin="2,0,8,0" />
        <ComboBox x:Name="CameraBox" Width="130" SelectedIndex="0" />
        <ComboBox x:Name="TimeBox" Width="120" SelectedIndex="1" />
        <ToggleButton x:Name="QualityToggle" Classes="chip" Content="Effects: high" IsChecked="True" />
        <ToggleButton x:Name="SoundToggle" Classes="chip" Content="Sound: on" IsChecked="True" />
        <Button x:Name="RestartButton" Classes="chip" Content="Restart (R)" />
        <Button x:Name="HelpButton" Classes="chip" Content="Controls (H)" />
      </StackPanel>
    </Border>

    <!-- Status -->
    <Border Classes="panel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock x:Name="StatusText" Classes="hud" FontSize="12" Foreground="#9BA7B4"
                   Text="W/↑ throttle · S/↓ brake · A/D steer · Space hop · ←/→ air control · C camera · R restart · Gamepad: RT/LT, sticks, A hop, Y camera, B restart" />
        <TextBlock x:Name="StatsText" Classes="hud" FontSize="12" Foreground="#5F6C79" Text="" />
      </StackPanel>
    </Border>

    <!-- Centre message: countdown, off track warning, finish -->
    <TextBlock x:Name="CentreText" Classes="hud" FontSize="40" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"
               Foreground="#FFD37A" />

    <!-- Help / pause overlay -->
    <Border x:Name="HelpOverlay" Background="#CC060A0F" IsVisible="False">
      <Border Classes="panel" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,24" Width="520">
        <StackPanel Spacing="10">
          <TextBlock Classes="hud" FontSize="22" FontWeight="Bold" Text="Three.Net Motocross" />
          <TextBlock Classes="hud" FontSize="12" Foreground="#9BA7B4" TextWrapping="Wrap"
                     Text="A procedurally generated motocross circuit: cascaded shadow maps, SSAO, bloom, PBR materials with generated textures, arcade suspension physics, particle roost and a synthesised engine." />
          <Border Height="1" Background="#242C36" Margin="0,6" />
          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Classes="hud" Text="W / Up" />
            <TextBlock Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Throttle" />
            <TextBlock Grid.Row="1" Classes="hud" Text="S / Down" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Brake / reverse" />
            <TextBlock Grid.Row="2" Classes="hud" Text="A / D" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Steer (lean in corners)" />
            <TextBlock Grid.Row="3" Classes="hud" Text="Left / Right" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Air control: whip the bike nose up or down" />
            <TextBlock Grid.Row="4" Classes="hud" Text="Space" />
            <TextBlock Grid.Row="4" Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Hop / preload the suspension" />
            <TextBlock Grid.Row="5" Classes="hud" Text="C · T · R · P" />
            <TextBlock Grid.Row="5" Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Camera · time of day · restart · pause" />
            <TextBlock Grid.Row="6" Classes="hud" Text="Backspace" />
            <TextBlock Grid.Row="6" Grid.Column="1" Classes="hud" Foreground="#9BA7B4" Text="Respawn at the last checkpoint" />
          </Grid>
          <TextBlock x:Name="AudioNote" Classes="hud" FontSize="11" Foreground="#C88C4A" IsVisible="False" />
          <Button x:Name="CloseHelpButton" Classes="chip" Content="Ride (Esc)" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
