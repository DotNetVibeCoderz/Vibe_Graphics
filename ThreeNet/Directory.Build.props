<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Interop heavy code: allow unsafe blocks and generated marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Gravicode Studios</Authors>
    <Company>Gravicode Studios</Company>
    <Product>Three.Net</Product>
    <Copyright>Copyright (c) Gravicode Studios - led by Kang Fadhil</Copyright>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Graphics/tree/main/ThreeNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Graphics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- A dragon breathing a three colour flame. The artwork is generated and
         kept at full size in docs/images/package-icon-source.png; tools/PackageIcon
         resizes it to the 256 square NuGet wants and fails if the result passes
         the one megabyte limit. The icon is baked into a published version and
         cannot be changed without burning one, so it is a release blocker. -->
    <PackageIcon>icon.png</PackageIcon>
    <VersionPrefix>0.12.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
