<?xml version="1.0" encoding="utf-8"?>
<!--
  Three.Net App Generator (ThreeAppGen) configuration.
  Everything here can also be edited from Settings inside the app; saving there
  rewrites this file.

  Made by Gravicode Studios - led by Kang Fadhil.
-->
<configuration>
  <appSettings>
    <!-- Active provider: OpenAI | Claude | Gemini | Ollama -->
    <add key="Llm.Provider" value="OpenAI" />
    <add key="Llm.Temperature" value="0.2" />
    <add key="Llm.MaxTokens" value="8192" />
    <add key="Llm.SystemPrompt" value="" />

    <!-- OpenAI -->
    <add key="OpenAI.Model" value="gpt-5" />
    <add key="OpenAI.ApiKey" value="" />
    <add key="OpenAI.Endpoint" value="" />

    <!-- Anthropic Claude -->
    <add key="Claude.Model" value="claude-sonnet-5" />
    <add key="Claude.ApiKey" value="" />
    <add key="Claude.Endpoint" value="" />

    <!-- Google Gemini -->
    <add key="Gemini.Model" value="gemini-2.5-pro" />
    <add key="Gemini.ApiKey" value="" />
    <add key="Gemini.Endpoint" value="" />

    <!-- Ollama (local) -->
    <add key="Ollama.Model" value="llama3.2" />
    <add key="Ollama.ApiKey" value="" />
    <add key="Ollama.Endpoint" value="http://localhost:11434" />

    <!-- Tools -->
    <add key="Tavily.ApiKey" value="" />

    <!-- Editor and workspace -->
    <add key="Editor.ShowLineNumbers" value="true" />
    <add key="Editor.WordWrap" value="false" />
    <add key="Editor.FontSize" value="13" />
    <add key="Editor.TabSize" value="4" />
    <add key="Workspace.LastProject" value="" />
    <add key="Workspace.ChatPanelWidth" value="420" />
    <add key="Workspace.ChatPanelVisible" value="true" />
  </appSettings>
</configuration>
