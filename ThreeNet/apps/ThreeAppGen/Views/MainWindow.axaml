<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:models="clr-namespace:ThreeAppGen.Models"
        xmlns:services="clr-namespace:ThreeAppGen.Services"
        x:Class="ThreeAppGen.Views.MainWindow"
        Title="Three.Net App Generator"
        Width="1560" Height="940"
        MinWidth="1100" MinHeight="680"
        Background="{StaticResource CanvasBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ===== menu ===== -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New project..." Click="OnNewProject" InputGesture="Ctrl+Shift+N" />
        <MenuItem Header="_Open project folder..." Click="OnOpenProject" InputGesture="Ctrl+Shift+O" />
        <MenuItem Header="Open _file..." Click="OnOpenFile" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="_Save" Click="OnSaveFile" InputGesture="Ctrl+S" />
        <MenuItem Header="_Close project" Click="OnCloseProject" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" InputGesture="Alt+F4" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Go to line..." Click="OnGoToLine" InputGesture="Ctrl+G" />
        <MenuItem Header="_Format code" Click="OnFormatCode" InputGesture="Ctrl+K" />
      </MenuItem>
      <MenuItem Header="_Project">
        <MenuItem Header="_Build" Click="OnBuild" InputGesture="F6" />
        <MenuItem Header="_Run" Click="OnRun" InputGesture="F5" />
        <MenuItem Header="_Deploy (publish)" Click="OnDeploy" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Show _line numbers" Click="OnToggleLineNumbers" x:Name="LineNumbersMenuItem" />
        <MenuItem Header="Word _wrap" Click="OnToggleWordWrap" x:Name="WordWrapMenuItem" />
        <MenuItem Header="Toggle _chat panel" Click="OnToggleChat" InputGesture="Ctrl+J" />
        <MenuItem Header="Toggle lo_gs panel" Click="OnToggleLogs" InputGesture="Ctrl+L" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Convert Three.js project..." Click="OnConvertThreeJs" InputGesture="Ctrl+Shift+T" />
        <Separator />
        <MenuItem Header="_Settings..." Click="OnOpenSettings" InputGesture="Ctrl+," />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Three.Net App Generator" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- ===== toolbar ===== -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,1" Padding="10,7">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <Button Content="New" Click="OnNewProject" />
          <Button Content="Open" Click="OnOpenProject" />
          <Button Content="Save" Click="OnSaveFile" />
          <Border Width="1" Background="{StaticResource HairlineBrush}" Margin="4,2" />
          <Button Content="Go to line" Click="OnGoToLine" />
          <Button Content="Format" Click="OnFormatCode" />
          <Border Width="1" Background="{StaticResource HairlineBrush}" Margin="4,2" />
          <Button Content="Build" Click="OnBuild" Classes="accent" />
          <Button Content="Run" Click="OnRun" Classes="accent" />
          <Button Content="Deploy" Click="OnDeploy" />
          <Border Width="1" Background="{StaticResource HairlineBrush}" Margin="4,2" />
          <Button Content="Convert Three.js" Click="OnConvertThreeJs" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <ToggleButton x:Name="LogsToggle" Content="Logs" IsChecked="True" Click="OnToggleLogs" />
          <ToggleButton x:Name="ChatToggle" Content="Jack" IsChecked="True" Click="OnToggleChat" />
          <Button Content="Settings" Click="OnOpenSettings" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== body ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="260,1,*,1,Auto">

      <!-- explorer -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="label" Text="EXPLORER" />
                <TextBlock x:Name="ProjectNameText" Classes="mono" Text="no project" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="&#x21BB;" ToolTip.Tip="Refresh" Click="OnRefreshExplorer" />
            </Grid>
          </Border>

          <TreeView Grid.Row="1" x:Name="FileTree" SelectionChanged="OnFileSelected">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" DataType="models:FileNode">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource CodeFont}" />
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="1" />

      <!-- editor + logs -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1" Padding="14,8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="OpenFileText" Classes="mono" Text="No file open" Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock x:Name="DirtyText" Classes="mono" Text="" Foreground="{StaticResource WarningBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="CaretText" Classes="mono" Text="Ln 1, Col 1" />
          </Grid>
        </Border>

        <edit:TextEditor Grid.Row="1" x:Name="Editor"
                         ShowLineNumbers="True"
                         FontFamily="{StaticResource CodeFont}"
                         FontSize="13"
                         Background="{StaticResource CanvasBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Padding="12,10" />

        <GridSplitter Grid.Row="2" ResizeDirection="Rows" Height="1" HorizontalAlignment="Stretch" />

        <Border Grid.Row="3" x:Name="LogsPanel" Background="{StaticResource PanelBrush}" Height="200">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="12,7" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="OUTPUT / LOGS" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost" Content="Clear" Click="OnClearLogs" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="LogScroller" Padding="12,8">
              <ItemsControl x:Name="LogList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="services:LogEntry">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Time}" Classes="mono"
                                 Foreground="{StaticResource TextMutedBrush}" Width="62" />
                      <TextBlock Grid.Column="1" Text="{Binding Badge}" Classes="mono" Width="42" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="mono" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="1" />

      <!-- chat panel -->
      <Border Grid.Column="4" x:Name="ChatPanel" Width="440" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                  <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentSoftBrush}"
                          BorderBrush="#1E4570" BorderThickness="1">
                    <TextBlock Text="J" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel>
                    <TextBlock Classes="title" Text="Jack" />
                    <TextBlock Classes="label" Text="THE CODE BENDER" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Content="Clear" Click="OnClearChat" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <ComboBox Grid.Column="0" x:Name="ProviderCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnProviderChanged" />
                <ComboBox Grid.Column="1" x:Name="ModelCombo" HorizontalAlignment="Stretch"
                          IsEditable="True" SelectionChanged="OnModelChanged" />
              </Grid>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" x:Name="ChatScroller" Padding="14,12">
            <ItemsControl x:Name="ChatList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="services:ChatMessage">
                  <Border Classes="bubble" Classes.user="{Binding IsUser}" Classes.assistant="{Binding !IsUser}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="label" Text="{Binding Author}" />
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="2" Padding="14,12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <ItemsControl x:Name="AttachmentList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="services:ChatAttachment">
                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                      <TextBlock Classes="mono" Text="{Binding FileName}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <TextBox x:Name="ChatInput" AcceptsReturn="True" MinHeight="76" MaxHeight="170"
                       TextWrapping="Wrap" PlaceholderText="Ask Jack to build something... (Ctrl+Enter to send)"
                       KeyDown="OnChatInputKeyDown" />

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="Attach image" Click="OnAttachImage" />
                <Button Grid.Column="2" x:Name="SendButton" Content="Send" Classes="accent" Click="OnSendChat" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== status bar ===== -->
    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,0" Padding="14,5">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" x:Name="StatusText" Classes="mono" Text="Ready" />
        <TextBlock Grid.Column="2" x:Name="ModelStatusText" Classes="mono" Margin="0,0,16,0"
                   Foreground="{StaticResource AccentBrush}" Text="" />
        <TextBlock Grid.Column="3" Classes="mono" Foreground="{StaticResource TextMutedBrush}"
                   Text="ThreeAppGen - Gravicode Studios - Kang Fadhil" />
      </Grid>
    </Border>
  </Grid>
</Window>
