    /// <summary>THREE.LatheGeometry(points, segments): revolves (x, y) points around the Y axis.</summary>
    public static Geometry CreateLatheGeometry(Scene scene, IReadOnlyList<Vector2> points, int segments = 12)
    {
        segments = Math.Max(3, segments);
        List<Vertex> vertices = new((segments + 1) * points.Count);
        List<uint> indices = new(segments * (points.Count - 1) * 6);
        for (int i = 0; i <= segments; i++)
        {
            float phi = i / (float)segments * MathF.Tau;
            float sin = MathF.Sin(phi);
            float cos = MathF.Cos(phi);
            for (int j = 0; j < points.Count; j++)
            {
                Vector3 position = new(points[j].X * sin, points[j].Y, points[j].X * cos);
                vertices.Add(new Vertex(position, new Vector3(sin, 0f, cos), new Vector2(i / (float)segments, j / (float)(points.Count - 1))));
            }
        }

        int count = points.Count;
        for (int i = 0; i < segments; i++)
        {
            for (int j = 0; j < count - 1; j++)
            {
                uint a = (uint)((i * count) + j);
                uint b = (uint)((i * count) + j + 1);
                uint c = (uint)(((i + 1) * count) + j);
                uint d = (uint)(((i + 1) * count) + j + 1);
                AddOutward(indices, vertices, a, c, b, fromAxis: true);
                AddOutward(indices, vertices, b, c, d, fromAxis: true);
            }
        }

        return Finish(scene, vertices, indices);
    }

    private static Vector2 SphericalUv(Vector3 point)
    {
        Vector3 n = Vector3.Normalize(point);
        return new Vector2(0.5f + (MathF.Atan2(n.Z, n.X) / MathF.Tau), 0.5f - (MathF.Asin(Math.Clamp(n.Y, -1f, 1f)) / MathF.PI));
    }

    /// <summary>Appends a triangle wound so its normal points away from the centre (or the Y axis).</summary>
    private static void AddOutward(List<uint> indices, List<Vertex> vertices, uint a, uint b, uint c, bool fromAxis = false)
    {
        Vector3 pa = vertices[(int)a].Position;
        Vector3 pb = vertices[(int)b].Position;
        Vector3 pc = vertices[(int)c].Position;
        Vector3 normal = Vector3.Cross(pb - pa, pc - pa);
        Vector3 outward = vertices[(int)a].Normal + vertices[(int)b].Normal + vertices[(int)c].Normal;
        if (fromAxis)
        {
            Vector3 centroid = (pa + pb + pc) / 3f;
            outward = new Vector3(centroid.X, 0f, centroid.Z);
        }

        if (Vector3.Dot(normal, outward) < 0f)
        {
            indices.AddRange([a, c, b]);
        }
        else
        {
            indices.AddRange([a, b, c]);
        }
    }

    private static void AddFacing(List<uint> indices, List<Vertex> vertices, uint a, uint b, uint c, Vector3 facing)
    {
        Vector3 pa = vertices[(int)a].Position;
        Vector3 normal = Vector3.Cross(vertices[(int)b].Position - pa, vertices[(int)c].Position - pa);
        indices.AddRange(Vector3.Dot(normal, facing) < 0f ? [a, c, b] : [a, b, c]);
    }

    private static Geometry Finish(Scene scene, List<Vertex> vertices, List<uint> indices, bool computeNormals = true)
    {
        Geometry geometry = scene.CreateGeometry(vertices.ToArray(), indices.ToArray());
        if (computeNormals)
        {
            geometry.ComputeNormals();
        }

        geometry.ComputeTangents();
        return geometry;
    }
