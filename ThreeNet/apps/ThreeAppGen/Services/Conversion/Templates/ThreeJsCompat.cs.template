        for (int i = 0; i <= tubularSegments; i++)
        {
            float u = i / (float)tubularSegments * p * MathF.Tau;
            Vector3 p1 = CurvePoint(u);
            Vector3 p2 = CurvePoint(u + 0.01f);
            Vector3 tangent = p2 - p1;
            Vector3 normal = p2 + p1;
            Vector3 binormal = Vector3.Normalize(Vector3.Cross(tangent, normal));
            normal = Vector3.Normalize(Vector3.Cross(binormal, tangent));

            for (int j = 0; j <= radialSegments; j++)
            {
                float v = j / (float)radialSegments * MathF.Tau;
                float cx = -tube * MathF.Cos(v);
                float cy = tube * MathF.Sin(v);
                Vector3 position = p1 + (normal * cx) + (binormal * cy);
                vertices.Add(new Vertex(position, Vector3.Normalize(position - p1), new Vector2(i / (float)tubularSegments, j / (float)radialSegments)));
            }
        }

        for (int i = 1; i <= tubularSegments; i++)
        {
            for (int j = 1; j <= radialSegments; j++)
            {
                uint a = (uint)(((radialSegments + 1) * (i - 1)) + (j - 1));
                uint b = (uint)(((radialSegments + 1) * i) + (j - 1));
                uint c = (uint)(((radialSegments + 1) * i) + j);
                uint d = (uint)(((radialSegments + 1) * (i - 1)) + j);
                AddOutward(indices, vertices, a, b, d);
                AddOutward(indices, vertices, b, c, d);
            }
        }

        // The analytic tube normals are exact; averaging would only blur them.
        return Finish(scene, vertices, indices, computeNormals: false);
    }

